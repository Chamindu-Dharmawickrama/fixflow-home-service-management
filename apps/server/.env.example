# FixFlow API — environment variables.
# Copy this file to `.env` for local development (it is loaded in development and test only,
# never in production, and never overrides variables that are already set). Never commit `.env`,
# and never put real secrets in this example file.
#
# Every variable has a safe default for local development, so the API starts with no `.env`
# (without DATABASE_URL it still starts, but /api/v1/health/ready reports 503 and nothing that
# needs the database works). On startup the API validates all of these and exits with the NAMES
# of any missing or invalid variables (never their values).

# Runtime mode: development | test | production. Default: development.
# Production additionally requires WEB_ORIGIN, DATABASE_URL, SESSION_SECRET and the Upstash
# credentials below.
NODE_ENV=development

# Port the API listens on (1-65535). Default: 4000.
PORT=4000

# Log verbosity: fatal | error | warn | info | debug | trace | silent.
# Default: info (silent when NODE_ENV=test). Development prints human-readable output;
# every other mode prints one JSON object per line.
LOG_LEVEL=info

# The one browser origin allowed by CORS (scheme + host [+ port], no path or trailing slash).
# Default in development/test: http://localhost:3000. REQUIRED in production, for example
# https://fixflow.example.com
WEB_ORIGIN=http://localhost:3000

# How many reverse proxies sit in front of the API, so the real client IP is used for rate
# limiting: false | true | a number of hops. Default: false (development/test) and 1 (production,
# the hosting platform's load balancer). Do not set it higher than the real number of proxies:
# clients could then spoof their IP.
# TRUST_PROXY=1

# --- Rate limiting -------------------------------------------------------------------------
# Distributed rate limiting uses Upstash Redis (REST API) and nothing else (D-12). Both values are
# required together and come from the Upstash console. Leave them blank locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# memory | upstash. Default: upstash when both credentials above are set, otherwise memory.
# The in-memory limiter counts per process only, so production refuses to start with it.
# RATE_LIMIT_DRIVER=memory

# Multiplies every named rate limit. Test and E2E environments set a large value (for example
# 1000) so repeated runs are not throttled; dedicated tests still verify the 429 behaviour with
# low explicit limits. Must be 1 (the default) in production.
# RATE_LIMIT_MULTIPLIER=1

# --- Database (PostgreSQL through Prisma) ---------------------------------------------------
# The three URLs below point at three DIFFERENT databases. Never point the test URL at a database
# you care about: the integration tests empty every table in it.
#
# Local development with Docker: `npm run db:test:up` starts PostgreSQL on port 5433 with a
# database called fixflow_test (the tests). Create a second database for development once:
#   docker compose exec postgres createdb -U fixflow_test fixflow_dev
# These credentials are throwaway values for a database that only listens on localhost.

# Runtime connection, used by the running API. On Neon this is the POOLED connection string (the
# host contains "-pooler") and must end with ?sslmode=require. REQUIRED in production.
# (The pg driver prints a one-off SECURITY WARNING for sslmode=require, because it already treats
# it as verify-full. ?sslmode=verify-full behaves the same for Neon and is silent.)
DATABASE_URL=postgresql://fixflow_test:fixflow_test@localhost:5433/fixflow_dev

# Direct (non-pooled) connection, used only by the Prisma CLI for migrations: `npm run db:migrate`
# and `npm run db:deploy`. On Neon this is the connection string WITHOUT "-pooler", also with
# ?sslmode=require. If unset, the CLI falls back to DATABASE_URL (fine for a local database).
DIRECT_DATABASE_URL=postgresql://fixflow_test:fixflow_test@localhost:5433/fixflow_dev

# The dedicated integration-test database. `npm run test:integration` applies the migrations to it
# and empties it before each test. src/test/db.ts refuses to run unless NODE_ENV is "test" and this
# is a different database from DATABASE_URL and DIRECT_DATABASE_URL.
TEST_DATABASE_URL=postgresql://fixflow_test:fixflow_test@localhost:5433/fixflow_test

# The Playwright suite's database (`npm run test:e2e`). It is NOT read by the API: the E2E tooling
# reads it from the environment, defaulting to the value below, and starts its own API against it.
# It is created (if missing), migrated, emptied and re-seeded on every run, so its name must contain
# "e2e" and it must be a different database from the three above. Set it only to use another one.
# E2E_DATABASE_URL=postgresql://fixflow_test:fixflow_test@localhost:5433/fixflow_e2e

# --- Demo accounts (seed only) --------------------------------------------------------------
# `npm run db:seed` creates three demo accounts (D-09) and hashes these passwords with Argon2id.
# It refuses to run without both, and no password is stored in the source code. They follow the
# password policy: 10-128 characters and not a common password.
# DEMO-ONLY values: they are documented publicly on purpose. Never use them for a real account,
# and set different values wherever the demo is hosted.
DEMO_ADMIN_PASSWORD=DemoAdmin-2026!
DEMO_CUSTOMER_PASSWORD=DemoCustomer-2026!

# --- Authentication (D-07 to D-11, D-51) ---------------------------------------------------
# HMAC key for session cookies and password-reset links (at least 32 characters). REQUIRED in
# production. Elsewhere, leave it out and a random key is generated on every start, which signs
# everyone out whenever the API restarts. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out. This value is a throwaway for local development.
SESSION_SECRET=local-development-session-secret-change-me-0123456789

# Who may use the admin area (D-08): comma-separated email addresses. An admin account exists only
# for these. Local registration never creates an admin; they sign in with Google (verified email)
# or are seeded. The demo admin must be listed, or requireAdmin refuses it. Removing an address
# and restarting revokes that person's admin access at once.
ADMIN_EMAILS=admin@demo.fixflow.test

# The OAuth 2.0 Web client ID for Google Sign-In (Google Cloud Console > APIs & Services >
# Credentials), ending in .apps.googleusercontent.com. Add http://localhost:3000 as an authorized
# JavaScript origin. Google ID tokens must be issued for this client. Leave blank to switch Google
# sign-in off (email and password still work). The web app needs the same value in
# NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=

# Public demo mode (D-09): the shared demo accounts cannot change their password or ask for a
# reset, so one visitor cannot lock the others out. true | false. Default: false.
DEMO_MODE=false

# Set to false to close registration (local and Google) without a code change. Existing accounts
# keep working. true | false. Default: true.
PUBLIC_SIGNUP_ENABLED=true

# --- E-mail (D-13, D-52) --------------------------------------------------------------------
# log | smtp. Default: smtp when SMTP_HOST is set, otherwise log. The log transport delivers
# nothing: it writes each email to .data/outbox/<timestamp>-<template>.txt and .html at the
# repository root (outside production) and records it as "logged only", never "sent". Addresses on
# reserved domains (.test, .example, example.com, ...) always use the log transport, whatever
# this says (D-52).
# In PRODUCTION: smtp requires ALL of EMAIL_FROM, SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER and
# SMTP_PASSWORD (the API refuses to start without them). log is allowed, but the server warns that
# nothing will be delivered and password reset is unavailable.
# EMAIL_TRANSPORT=log

# The From header. Required for the smtp transport.
# EMAIL_FROM=CoolBreeze Home Services <hello@coolbreeze.example>

# SMTP server (Nodemailer, pooled connections with timeouts). SMTP_SECURE=true means TLS from the
# first byte (usually port 465); false means STARTTLS when the server offers it (usually port 587,
# the default). In production a server that cannot upgrade to TLS is refused. SMTP_USER and
# SMTP_PASSWORD go together.
# Try it with: npm run email:test -w @fixflow/server -- --to you@your-own-domain.com
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# The web app's public origin, used for absolute links in emails (the reset link, the "view your
# quotation" button, ...). Default: WEB_ORIGIN.
# PUBLIC_WEB_URL=http://localhost:3000

# Where the log transport writes emails. Default: <repository>/.data/outbox
# EMAIL_OUTBOX_DIR=
