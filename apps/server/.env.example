# FixFlow API — environment variables.
# Copy this file to `.env` for local development (it is loaded in development and test only,
# never in production, and never overrides variables that are already set). Never commit `.env`,
# and never put real secrets in this example file.
#
# Every variable has a safe default for local development, so the API starts with no `.env`
# (without DATABASE_URL it still starts, but /api/v1/health/ready reports 503 and nothing that
# needs the database works). On startup the API validates all of these and exits with the NAMES
# of any missing or invalid variables (never their values). Later tasks add the session, e-mail
# and Google variables.

# Runtime mode: development | test | production. Default: development.
# Production additionally requires WEB_ORIGIN, DATABASE_URL and the Upstash credentials below.
NODE_ENV=development

# Port the API listens on (1-65535). Default: 4000.
PORT=4000

# Log verbosity: fatal | error | warn | info | debug | trace | silent.
# Default: info (silent when NODE_ENV=test). Development prints human-readable output;
# every other mode prints one JSON object per line.
LOG_LEVEL=info

# The one browser origin allowed by CORS (scheme + host [+ port], no path or trailing slash).
# Default in development/test: http://localhost:3000. REQUIRED in production, for example
# https://fixflow.example.com
WEB_ORIGIN=http://localhost:3000

# How many reverse proxies sit in front of the API, so the real client IP is used for rate
# limiting: false | true | a number of hops. Default: false (development/test) and 1 (production,
# the hosting platform's load balancer). Do not set it higher than the real number of proxies:
# clients could then spoof their IP.
# TRUST_PROXY=1

# --- Rate limiting -------------------------------------------------------------------------
# Distributed rate limiting uses Upstash Redis (REST API) and nothing else (D-12). Both values are
# required together and come from the Upstash console. Leave them blank locally.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# memory | upstash. Default: upstash when both credentials above are set, otherwise memory.
# The in-memory limiter counts per process only, so production refuses to start with it.
# RATE_LIMIT_DRIVER=memory

# Multiplies every named rate limit. Test and E2E environments set a large value (for example
# 1000) so repeated runs are not throttled; dedicated tests still verify the 429 behaviour with
# low explicit limits. Must be 1 (the default) in production.
# RATE_LIMIT_MULTIPLIER=1

# --- Database (PostgreSQL through Prisma) ---------------------------------------------------
# The three URLs below point at three DIFFERENT databases. Never point the test URL at a database
# you care about: the integration tests empty every table in it.
#
# Local development with Docker: `npm run db:test:up` starts PostgreSQL on port 5433 with a
# database called fixflow_test (the tests). Create a second database for development once:
#   docker compose exec postgres createdb -U fixflow_test fixflow_dev
# These credentials are throwaway values for a database that only listens on localhost.

# Runtime connection, used by the running API. On Neon this is the POOLED connection string (the
# host contains "-pooler") and must end with ?sslmode=require. REQUIRED in production.
# (The pg driver prints a one-off SECURITY WARNING for sslmode=require, because it already treats
# it as verify-full. ?sslmode=verify-full behaves the same for Neon and is silent.)
DATABASE_URL=postgresql://fixflow_test:fixflow_test@localhost:5433/fixflow_dev

# Direct (non-pooled) connection, used only by the Prisma CLI for migrations: `npm run db:migrate`
# and `npm run db:deploy`. On Neon this is the connection string WITHOUT "-pooler", also with
# ?sslmode=require. If unset, the CLI falls back to DATABASE_URL (fine for a local database).
DIRECT_DATABASE_URL=postgresql://fixflow_test:fixflow_test@localhost:5433/fixflow_dev

# The dedicated integration-test database. `npm run test:integration` applies the migrations to it
# and empties it before each test. src/test/db.ts refuses to run unless NODE_ENV is "test" and this
# is a different database from DATABASE_URL and DIRECT_DATABASE_URL.
TEST_DATABASE_URL=postgresql://fixflow_test:fixflow_test@localhost:5433/fixflow_test

# --- Demo accounts (seed only) --------------------------------------------------------------
# `npm run db:seed` creates three demo accounts (D-09) and hashes these passwords with Argon2id.
# It refuses to run without both, and no password is stored in the source code. 10-128 characters.
# DEMO-ONLY values: they are documented publicly on purpose. Never use them for a real account,
# and set different values wherever the demo is hosted.
DEMO_ADMIN_PASSWORD=DemoAdmin-2026!
DEMO_CUSTOMER_PASSWORD=DemoCustomer-2026!
