{
  "name": "@fixflow/server",
  "version": "0.0.0",
  "private": true,
  "description": "FixFlow REST API (Express 5)",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:verify-demo": "tsx prisma/verify-demo.ts",
    "db:reset-demo": "tsx prisma/reset-demo.ts",
    "db:studio": "prisma studio",
    "email:test": "tsx scripts/email-test.ts",
    "demo:notifications": "tsx scripts/demo-notifications.ts"
  },
  "dependencies": {
    "@date-fns/tz": "^1.5.0",
    "@fixflow/shared": "*",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.40.0",
    "axios": "^1.21.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.1",
    "helmet": "^8.3.0",
    "nodemailer": "^10.2.1",
    "pdfmake": "^0.3.14",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfmake": "^0.3.3",
    "@types/supertest": "^7.2.0",
    "pdf-parse": "^2.4.5",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
