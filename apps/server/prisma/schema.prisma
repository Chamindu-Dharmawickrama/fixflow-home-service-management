// FixFlow data model (spec §12, decisions D-15…D-18, D-27, D-29, D-36, D-38, D-45, D-50).
//
// Conventions
//   - Tables and columns are snake_case (@@map / @map); models and fields are camelCase.
//   - Ids are database-generated UUIDs. Timestamps are timestamptz(3), UTC. Date-only fields are date.
//   - Money is Decimal(12,2), quantities Decimal(10,2), tax rates Decimal(5,2). Never a float (D-18).
//   - Enum values equal the constants in @fixflow/shared; apps/server/src/db/enum-parity.test.ts
//     fails if the two drift apart.
//   - Invariants Prisma cannot express (partial unique indexes, CHECK constraints) live in the
//     migration `..._database_invariants`. Never edit an applied migration; add a new one.
//   - Datasource URLs are not declared here: Prisma 7 reads them from prisma.config.ts (direct URL,
//     for migrations) and the runtime client receives the pooled URL through its driver adapter.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------------------------

enum Role {
  BUSINESS_ADMIN
  CUSTOMER

  @@map("role")
}

enum PricingMode {
  FIXED
  QUOTE_REQUIRED

  @@map("pricing_mode")
}

enum ServiceRequestStatus {
  SUBMITTED
  UNDER_REVIEW
  QUOTED
  ACCEPTED
  DECLINED
  CONVERTED_TO_JOB
  CANCELLED

  @@map("service_request_status")
}

enum PreferredWindow {
  MORNING
  AFTERNOON
  EVENING

  @@map("preferred_window")
}

enum NoteVisibility {
  INTERNAL
  CUSTOMER_VISIBLE

  @@map("note_visibility")
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  VOID

  @@map("quotation_status")
}

enum WorkOrderStatus {
  PENDING_SCHEDULING
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NEEDS_RESCHEDULING

  @@map("work_order_status")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID

  @@map("invoice_status")
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CARD_TERMINAL
  CHEQUE
  OTHER

  @@map("payment_method")
}

enum NotificationType {
  REQUEST_RECEIVED
  QUOTATION_ACCEPTED
  QUOTATION_DECLINED
  QUOTATION_SENT
  QUOTATION_WITHDRAWN
  REQUEST_CANCELLED
  NOTE_ADDED
  JOB_SCHEDULED
  JOB_RESCHEDULED
  JOB_NEEDS_RESCHEDULING
  JOB_COMPLETED
  JOB_CANCELLED
  INVOICE_ISSUED
  INVOICE_VOIDED
  PAYMENT_RECORDED

  @@map("notification_type")
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  LOGGED
  FAILED
  SKIPPED

  @@map("email_delivery_status")
}

enum ActivityEntityType {
  SERVICE_REQUEST
  QUOTATION
  WORK_ORDER
  INVOICE
  PAYMENT
  SERVICE
  TECHNICIAN
  SETTINGS
  CUSTOMER

  @@map("activity_entity_type")
}

enum ReferenceType {
  REQUEST
  QUOTATION
  WORK_ORDER
  INVOICE

  @@map("reference_type")
}

// ---------------------------------------------------------------------------------------------
// Identity and sessions
// ---------------------------------------------------------------------------------------------

/// One row per person, local password and/or Google (D-07). `email` is stored normalized
/// (trimmed, lower case); a CHECK constraint rejects anything else, so the unique index really
/// is a case-insensitive uniqueness rule (FR-032).
model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  name            String
  avatarUrl       String?   @map("avatar_url")
  role            Role
  /// Argon2id hash (D-51). Null for Google-only accounts.
  passwordHash    String?   @map("password_hash")
  /// Google's stable `sub` claim. Null for local-only accounts.
  googleSubject   String?   @unique @map("google_subject")
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  isActive        Boolean   @default(true) @map("is_active")
  termsAcceptedAt DateTime? @map("terms_accepted_at") @db.Timestamptz(3)
  lastSignInAt    DateTime? @map("last_sign_in_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions            Session[]
  passwordResetTokens PasswordResetToken[]
  customerProfile     CustomerProfile?
  customerNotes       CustomerNote[]
  requestNotes        RequestNote[]
  cancelledRequests   ServiceRequest[]     @relation("RequestCancelledBy")
  quotationsCreated   Quotation[]          @relation("QuotationCreatedBy")
  quotationsSent      Quotation[]          @relation("QuotationSentBy")
  quotationsResponded Quotation[]          @relation("QuotationRespondedBy")
  quotationsVoided    Quotation[]          @relation("QuotationVoidedBy")
  workOrdersCreated   WorkOrder[]          @relation("WorkOrderCreatedBy")
  invoicesCreated     Invoice[]            @relation("InvoiceCreatedBy")
  invoicesIssued      Invoice[]            @relation("InvoiceIssuedBy")
  invoicesVoided      Invoice[]            @relation("InvoiceVoidedBy")
  paymentsRecorded    PaymentRecord[]      @relation("PaymentRecordedBy")
  paymentsVoided      PaymentRecord[]      @relation("PaymentVoidedBy")
  notifications       Notification[]
  activityEvents      ActivityEvent[]
  settingsUpdated     BusinessSettings[]

  @@map("users")
}

/// A server-side session (D-10). Only the HMAC of the cookie token is stored.
model Session {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  userId     String   @map("user_id") @db.Uuid
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use, time-limited password-reset token; only its hash is stored (D-51).
model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------------------------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------------------------

/// The customer side of a CUSTOMER user. `customerId` columns elsewhere point here.
model CustomerProfile {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  phone     String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  addresses       ServiceAddress[]
  notes           CustomerNote[]
  serviceRequests ServiceRequest[]
  quotations      Quotation[]
  workOrders      WorkOrder[]
  invoices        Invoice[]
  activityEvents  ActivityEvent[]

  @@map("customer_profiles")
}

/// Staff-only note about a customer (FR-033). Never serialized to customers.
model CustomerNote {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId   String   @map("customer_id") @db.Uuid
  authorUserId String   @map("author_user_id") @db.Uuid
  body         String
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  customer CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  author   User            @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([customerId, createdAt])
  @@map("customer_notes")
}

/// At most one default address per customer (partial unique index in the invariants migration).
model ServiceAddress {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId  String   @map("customer_id") @db.Uuid
  label       String
  line1       String
  line2       String?
  city        String
  region      String?
  postalCode  String   @map("postal_code")
  accessNotes String?  @map("access_notes")
  isDefault   Boolean  @default(false) @map("is_default")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer        CustomerProfile  @relation(fields: [customerId], references: [id], onDelete: Restrict)
  serviceRequests ServiceRequest[]

  @@index([customerId])
  @@map("service_addresses")
}

// ---------------------------------------------------------------------------------------------
// Business configuration and catalogue
// ---------------------------------------------------------------------------------------------

/// The one settings row for the one business. The fixed id plus a CHECK constraint make a second
/// row impossible. The id is never exposed through the API; it only lets activity events refer to it.
model BusinessSettings {
  id                     String   @id @default(dbgenerated("'00000000-0000-4000-8000-000000000001'::uuid")) @db.Uuid
  businessName           String   @map("business_name")
  tagline                String?
  logoKey                String?  @map("logo_key")
  logoUrl                String?  @map("logo_url")
  contactEmail           String   @map("contact_email")
  phone                  String
  addressLine1           String   @map("address_line1")
  addressLine2           String?  @map("address_line2")
  city                   String
  region                 String?
  postalCode             String   @map("postal_code")
  serviceAreaDescription String?  @map("service_area_description")
  /// ISO 4217. Only 2-decimal currencies are supported (D-18).
  currencyCode           String   @map("currency_code") @db.Char(3)
  /// IANA time zone; business logic and display use this, never the browser's (BR-17).
  timeZone               String   @map("time_zone")
  /// Percentage, so 8.00 means 8 %.
  defaultTaxRate         Decimal  @map("default_tax_rate") @db.Decimal(5, 2)
  quotationValidityDays  Int      @map("quotation_validity_days")
  invoiceDueDays         Int      @map("invoice_due_days")
  defaultQuotationTerms  String?  @map("default_quotation_terms")
  invoiceFooter          String?  @map("invoice_footer")
  paymentInstructions    String?  @map("payment_instructions")
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  updatedByUserId        String?  @map("updated_by_user_id") @db.Uuid

  updatedBy User? @relation(fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@map("business_settings")
}

/// A service the business offers (D-50). Active = published and not archived.
model Service {
  id                       String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                     String
  slug                     String      @unique
  category                 String
  shortDescription         String      @map("short_description")
  fullDescription          String      @map("full_description")
  inclusions               String[]    @default([])
  estimatedDurationMinutes Int?        @map("estimated_duration_minutes")
  pricingMode              PricingMode @map("pricing_mode")
  /// "From" price. Required when `pricingMode` is FIXED (CHECK constraint).
  startingPrice            Decimal?    @map("starting_price") @db.Decimal(12, 2)
  imageKey                 String?     @map("image_key")
  imageUrl                 String?     @map("image_url")
  isPublished              Boolean     @default(false) @map("is_published")
  archivedAt               DateTime?   @map("archived_at") @db.Timestamptz(3)
  sortOrder                Int         @default(0) @map("sort_order")
  createdAt                DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  serviceRequests ServiceRequest[]
  workOrders      WorkOrder[]

  @@index([isPublished, archivedAt, sortOrder])
  @@map("services")
}

// ---------------------------------------------------------------------------------------------
// Service requests
// ---------------------------------------------------------------------------------------------

/// A customer's request. The service name and the address are copied here when it is submitted, so
/// later catalogue or address edits do not rewrite history (D-36).
model ServiceRequest {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// `FF-YYYY-NNNNN` (D-17).
  reference             String               @unique
  customerId            String               @map("customer_id") @db.Uuid
  serviceId             String               @map("service_id") @db.Uuid
  serviceNameSnapshot   String               @map("service_name_snapshot")
  /// The saved address it was copied from; null once that address is deleted.
  serviceAddressId      String?              @map("service_address_id") @db.Uuid
  addressLine1          String               @map("address_line1")
  addressLine2          String?              @map("address_line2")
  addressCity           String               @map("address_city")
  addressRegion         String?              @map("address_region")
  addressPostalCode     String               @map("address_postal_code")
  accessNotesSnapshot   String?              @map("access_notes_snapshot")
  description           String
  preferredDate         DateTime             @map("preferred_date") @db.Date
  preferredWindow       PreferredWindow      @map("preferred_window")
  /// The window as UTC instants, computed from the business time zone (D-35).
  preferredStart        DateTime             @map("preferred_start") @db.Timestamptz(3)
  preferredEnd          DateTime             @map("preferred_end") @db.Timestamptz(3)
  status                ServiceRequestStatus @default(SUBMITTED)
  cancelReason          String?              @map("cancel_reason")
  cancelCustomerMessage String?              @map("cancel_customer_message")
  cancelledAt           DateTime?            @map("cancelled_at") @db.Timestamptz(3)
  cancelledByUserId     String?              @map("cancelled_by_user_id") @db.Uuid
  /// Client-generated UUID that makes a repeated submit return the original request (D-45).
  submissionKey         String?              @map("submission_key") @db.Uuid
  submittedAt           DateTime             @default(now()) @map("submitted_at") @db.Timestamptz(3)
  updatedAt             DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer       CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service        Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  serviceAddress ServiceAddress? @relation(fields: [serviceAddressId], references: [id], onDelete: SetNull)
  cancelledBy    User?           @relation("RequestCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)
  notes          RequestNote[]
  quotations     Quotation[]
  workOrder      WorkOrder?
  activityEvents ActivityEvent[]

  @@unique([customerId, submissionKey])
  @@index([status, submittedAt])
  @@index([customerId])
  @@index([serviceId])
  @@map("service_requests")
}

/// Note on a request. INTERNAL notes are staff-only; filtering happens on the server (BR-19).
model RequestNote {
  id           String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  requestId    String         @map("request_id") @db.Uuid
  authorUserId String         @map("author_user_id") @db.Uuid
  body         String
  visibility   NoteVisibility
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  author  User           @relation(fields: [authorUserId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@map("request_notes")
}

// ---------------------------------------------------------------------------------------------
// Quotations
// ---------------------------------------------------------------------------------------------

/// A priced offer. A SENT quotation is immutable; a change creates a replacement that points back
/// through `replacesQuotationId` (BR-7). Per request there is at most one DRAFT, one SENT and one
/// ACCEPTED quotation (partial unique indexes in the invariants migration).
model Quotation {
  id                  String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// `QT-YYYY-NNNNN` (D-17).
  reference           String          @unique
  requestId           String          @map("request_id") @db.Uuid
  customerId          String          @map("customer_id") @db.Uuid
  status              QuotationStatus @default(DRAFT)
  currencyCode        String          @map("currency_code") @db.Char(3)
  taxRate             Decimal         @map("tax_rate") @db.Decimal(5, 2)
  subtotal            Decimal         @db.Decimal(12, 2)
  discountAmount      Decimal         @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxableBase         Decimal         @map("taxable_base") @db.Decimal(12, 2)
  taxAmount           Decimal         @map("tax_amount") @db.Decimal(12, 2)
  totalAmount         Decimal         @map("total_amount") @db.Decimal(12, 2)
  validUntil          DateTime        @map("valid_until") @db.Date
  terms               String?
  customerNote        String?         @map("customer_note")
  /// The quotation this one replaces; unique, so a quotation is replaced at most once.
  replacesQuotationId String?         @unique @map("replaces_quotation_id") @db.Uuid
  sentAt              DateTime?       @map("sent_at") @db.Timestamptz(3)
  sentByUserId        String?         @map("sent_by_user_id") @db.Uuid
  respondedAt         DateTime?       @map("responded_at") @db.Timestamptz(3)
  respondedByUserId   String?         @map("responded_by_user_id") @db.Uuid
  declineReason       String?         @map("decline_reason")
  voidedAt            DateTime?       @map("voided_at") @db.Timestamptz(3)
  voidedByUserId      String?         @map("voided_by_user_id") @db.Uuid
  voidReason          String?         @map("void_reason")
  expiredAt           DateTime?       @map("expired_at") @db.Timestamptz(3)
  createdByUserId     String          @map("created_by_user_id") @db.Uuid
  createdAt           DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  request     ServiceRequest      @relation(fields: [requestId], references: [id], onDelete: Restrict)
  customer    CustomerProfile     @relation(fields: [customerId], references: [id], onDelete: Restrict)
  replaces    Quotation?          @relation("QuotationReplacement", fields: [replacesQuotationId], references: [id], onDelete: Restrict)
  replacedBy  Quotation?          @relation("QuotationReplacement")
  sentBy      User?               @relation("QuotationSentBy", fields: [sentByUserId], references: [id], onDelete: Restrict)
  respondedBy User?               @relation("QuotationRespondedBy", fields: [respondedByUserId], references: [id], onDelete: Restrict)
  voidedBy    User?               @relation("QuotationVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)
  createdBy   User                @relation("QuotationCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lineItems   QuotationLineItem[]
  workOrder   WorkOrder?
  invoices    Invoice[]

  @@index([requestId, createdAt])
  @@index([customerId, status])
  @@index([status, validUntil])
  @@map("quotations")
}

/// A line of a quotation, snapshotted when the quotation is saved (DM-04).
model QuotationLineItem {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quotationId  String  @map("quotation_id") @db.Uuid
  position     Int
  description  String
  quantity     Decimal @db.Decimal(10, 2)
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  taxable      Boolean @default(true)
  lineSubtotal Decimal @map("line_subtotal") @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@unique([quotationId, position])
  @@map("quotation_line_items")
}

// ---------------------------------------------------------------------------------------------
// Technicians and work orders
// ---------------------------------------------------------------------------------------------

/// A resource the business can assign to a job. Not a user; has no login.
model Technician {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  phone         String?
  email         String?
  specialties   String[] @default([])
  notes         String?
  /// A key from the design-system calendar palette (never a raw colour value).
  calendarColor String   @map("calendar_color")
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workOrders WorkOrder[]

  @@map("technicians")
}

/// The operational record created from an accepted quotation. One per request and one per
/// quotation (unique foreign keys).
model WorkOrder {
  id                     String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// `JOB-YYYY-NNNNN` (D-17).
  reference              String          @unique
  requestId              String          @unique @map("request_id") @db.Uuid
  quotationId            String          @unique @map("quotation_id") @db.Uuid
  customerId             String          @map("customer_id") @db.Uuid
  serviceId              String          @map("service_id") @db.Uuid
  serviceNameSnapshot    String          @map("service_name_snapshot")
  addressLine1           String          @map("address_line1")
  addressLine2           String?         @map("address_line2")
  addressCity            String          @map("address_city")
  addressRegion          String?         @map("address_region")
  addressPostalCode      String          @map("address_postal_code")
  accessNotesSnapshot    String?         @map("access_notes_snapshot")
  scopeDescription       String          @map("scope_description")
  status                 WorkOrderStatus @default(PENDING_SCHEDULING)
  scheduledStart         DateTime?       @map("scheduled_start") @db.Timestamptz(3)
  scheduledEnd           DateTime?       @map("scheduled_end") @db.Timestamptz(3)
  technicianId           String?         @map("technician_id") @db.Uuid
  startedAt              DateTime?       @map("started_at") @db.Timestamptz(3)
  completedAt            DateTime?       @map("completed_at") @db.Timestamptz(3)
  /// Shown to the customer.
  completionNote         String?         @map("completion_note")
  /// Staff-only.
  internalCompletionNote String?         @map("internal_completion_note")
  cancelReason           String?         @map("cancel_reason")
  cancelledAt            DateTime?       @map("cancelled_at") @db.Timestamptz(3)
  createdByUserId        String          @map("created_by_user_id") @db.Uuid
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  request    ServiceRequest  @relation(fields: [requestId], references: [id], onDelete: Restrict)
  quotation  Quotation       @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  customer   CustomerProfile @relation(fields: [customerId], references: [id], onDelete: Restrict)
  service    Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  technician Technician?     @relation(fields: [technicianId], references: [id], onDelete: Restrict)
  createdBy  User            @relation("WorkOrderCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  invoices   Invoice[]

  @@index([technicianId, scheduledStart])
  @@index([status, scheduledStart])
  @@index([customerId])
  @@map("work_orders")
}

// ---------------------------------------------------------------------------------------------
// Invoices and payments
// ---------------------------------------------------------------------------------------------

/// A bill for a completed work order. At most one non-VOID invoice per work order (partial unique
/// index). `invoiceNumber` is assigned at issue, not at draft (D-17), so a draft has none.
/// `amountPaid` is denormalized and changes only inside payment transactions (D-26).
model Invoice {
  id                          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// `INV-YYYY-NNNNN`, assigned when the invoice is issued.
  invoiceNumber               String?       @unique @map("invoice_number")
  workOrderId                 String        @map("work_order_id") @db.Uuid
  quotationId                 String?       @map("quotation_id") @db.Uuid
  customerId                  String        @map("customer_id") @db.Uuid
  status                      InvoiceStatus @default(DRAFT)
  currencyCode                String        @map("currency_code") @db.Char(3)
  taxRate                     Decimal       @map("tax_rate") @db.Decimal(5, 2)
  subtotal                    Decimal       @db.Decimal(12, 2)
  discountAmount              Decimal       @default(0) @map("discount_amount") @db.Decimal(12, 2)
  taxableBase                 Decimal       @map("taxable_base") @db.Decimal(12, 2)
  taxAmount                   Decimal       @map("tax_amount") @db.Decimal(12, 2)
  totalAmount                 Decimal       @map("total_amount") @db.Decimal(12, 2)
  amountPaid                  Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  issueDate                   DateTime?     @map("issue_date") @db.Date
  dueDate                     DateTime?     @map("due_date") @db.Date
  issuedAt                    DateTime?     @map("issued_at") @db.Timestamptz(3)
  issuedByUserId              String?       @map("issued_by_user_id") @db.Uuid
  customerNote                String?       @map("customer_note")
  /// Business details as they were when the invoice was issued.
  businessSnapshot            Json?         @map("business_snapshot") @db.JsonB
  /// Customer name, e-mail, phone and billing address as they were when the invoice was issued.
  customerSnapshot            Json?         @map("customer_snapshot") @db.JsonB
  paymentInstructionsSnapshot String?       @map("payment_instructions_snapshot")
  footerSnapshot              String?       @map("footer_snapshot")
  voidedAt                    DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedByUserId              String?       @map("voided_by_user_id") @db.Uuid
  voidReason                  String?       @map("void_reason")
  createdByUserId             String        @map("created_by_user_id") @db.Uuid
  createdAt                   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  workOrder WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  quotation Quotation?        @relation(fields: [quotationId], references: [id], onDelete: Restrict)
  customer  CustomerProfile   @relation(fields: [customerId], references: [id], onDelete: Restrict)
  issuedBy  User?             @relation("InvoiceIssuedBy", fields: [issuedByUserId], references: [id], onDelete: Restrict)
  voidedBy  User?             @relation("InvoiceVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)
  createdBy User              @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  lineItems InvoiceLineItem[]
  payments  PaymentRecord[]

  @@index([workOrderId])
  @@index([customerId, status])
  @@index([status, dueDate])
  @@map("invoices")
}

model InvoiceLineItem {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId    String  @map("invoice_id") @db.Uuid
  position     Int
  description  String
  quantity     Decimal @db.Decimal(10, 2)
  unitPrice    Decimal @map("unit_price") @db.Decimal(12, 2)
  taxable      Boolean @default(true)
  lineSubtotal Decimal @map("line_subtotal") @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@unique([invoiceId, position])
  @@map("invoice_line_items")
}

/// A manually recorded payment (D-27). A correction is a void (with reason) plus a new record;
/// payments are never edited or deleted.
model PaymentRecord {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoiceId        String        @map("invoice_id") @db.Uuid
  amount           Decimal       @db.Decimal(12, 2)
  paymentDate      DateTime      @map("payment_date") @db.Date
  method           PaymentMethod
  reference        String?
  notes            String?
  recordedByUserId String        @map("recorded_by_user_id") @db.Uuid
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  voidedAt         DateTime?     @map("voided_at") @db.Timestamptz(3)
  voidedByUserId   String?       @map("voided_by_user_id") @db.Uuid
  voidReason       String?       @map("void_reason")

  invoice    Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy User    @relation("PaymentRecordedBy", fields: [recordedByUserId], references: [id], onDelete: Restrict)
  voidedBy   User?   @relation("PaymentVoidedBy", fields: [voidedByUserId], references: [id], onDelete: Restrict)

  @@index([invoiceId, paymentDate])
  @@map("payment_records")
}

// ---------------------------------------------------------------------------------------------
// Notifications, e-mail and activity
// ---------------------------------------------------------------------------------------------

/// An in-app notification for exactly one recipient (D-38). `linkPath` is a relative app path.
model Notification {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  recipientUserId String              @map("recipient_user_id") @db.Uuid
  type            NotificationType
  title           String
  message         String
  linkPath        String              @map("link_path")
  entityType      ActivityEntityType? @map("entity_type")
  entityId        String?             @map("entity_id") @db.Uuid
  readAt          DateTime?           @map("read_at") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  recipient       User               @relation(fields: [recipientUserId], references: [id], onDelete: Restrict)
  emailDeliveries EmailDeliveryLog[]

  @@index([recipientUserId, readAt, createdAt])
  @@map("notifications")
}

/// One attempt to send one e-mail. Stores a masked recipient and a safe error code, never the body
/// or provider secrets (D-13). `LOGGED` means the log transport wrote it; it is never `SENT`.
model EmailDeliveryLog {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  notificationId  String?             @map("notification_id") @db.Uuid
  template        String
  recipientMasked String              @map("recipient_masked")
  transport       String
  status          EmailDeliveryStatus
  errorCode       String?             @map("error_code")
  attemptedAt     DateTime?           @map("attempted_at") @db.Timestamptz(3)
  sentAt          DateTime?           @map("sent_at") @db.Timestamptz(3)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([notificationId])
  @@index([status, createdAt])
  @@map("email_delivery_logs")
}

/// The single append-only history table (D-29). `summary` is internal; the customer timeline
/// shows only events whose `publicSummary` is set and whose `customerId` matches the viewer.
/// Application code only inserts, through `recordActivity()`; `metadata` holds allowlisted,
/// non-sensitive keys only.
model ActivityEvent {
  id            String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Null means the system acted (for example an expiry job).
  actorUserId   String?            @map("actor_user_id") @db.Uuid
  entityType    ActivityEntityType @map("entity_type")
  entityId      String             @map("entity_id") @db.Uuid
  action        String
  fromStatus    String?            @map("from_status")
  toStatus      String?            @map("to_status")
  summary       String
  publicSummary String?            @map("public_summary")
  metadata      Json               @default("{}") @db.JsonB
  /// Correlation: the request this event belongs to, if any.
  requestId     String?            @map("request_id") @db.Uuid
  /// Correlation: the customer this event belongs to, if any.
  customerId    String?            @map("customer_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  actor    User?            @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  request  ServiceRequest?  @relation(fields: [requestId], references: [id], onDelete: Restrict)
  customer CustomerProfile? @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
  @@index([requestId, createdAt])
  @@index([customerId, createdAt])
  @@index([createdAt])
  @@map("activity_events")
}

/// Per-type, per-year counter behind the human-readable references (D-17). Incremented with an
/// atomic upsert inside the business transaction, so a rolled-back transaction leaves no gap.
model ReferenceCounter {
  type  ReferenceType
  year  Int
  value Int

  @@id([type, year])
  @@map("reference_counters")
}
