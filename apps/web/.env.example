# FixFlow web app — environment variables.
# Copy this file to `.env.local` for local development. Never commit `.env*` files other than
# this example, and never expose secrets through a NEXT_PUBLIC_ variable.

# Server-only (no NEXT_PUBLIC_ prefix). Where the Next.js server reaches the Express API.
# The browser never needs this: it calls /api/v1/* on the web origin and Next.js rewrites it here.
# next.config.ts reads it at BUILD time, so deployments must set it before `next build`.
# Defaults to http://localhost:4000 when unset.
API_INTERNAL_URL=http://localhost:4000

# --- Sign-in ---------------------------------------------------------------------------------
# NEXT_PUBLIC_ variables are compiled into the browser bundle at build time, so they are public.
# Only put values here that are meant to be public.

# The Google OAuth 2.0 Web client ID for "Sign in with Google" (the same value as the API's
# GOOGLE_CLIENT_ID; a client ID is not a secret). In the Google Cloud Console, add
# http://localhost:3000 as an authorized JavaScript origin. Leave blank to hide the Google button
# behind an explanation (email and password still work).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# The public address of the website (T08, D-89): canonical links, social previews and the sitemap are
# built from it. Only the origin is used. On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used when this is
# blank; locally it falls back to http://localhost:3000.
SITE_URL=

# How long the public pages hold what they read from the API before refreshing it, in whole seconds
# (1 to 3600; blank or invalid means 60). A change in the admin area (the business name, a service
# archived) shows on the public site after about this long (T08, D-87).
PUBLIC_REVALIDATE_SECONDS=60

# Public demo mode (D-09). When "true", the sign-in page shows a "Demo accounts" panel whose
# buttons fill in the form, and the register page shows the public-demo privacy notice. It also shows
# the portfolio-demo banner on the public website and asks search engines not to index it (D-89).
# The passwords are the demo accounts' PUBLISHED passwords (the same values as the API's
# DEMO_ADMIN_PASSWORD and DEMO_CUSTOMER_PASSWORD). They are public by design: never use values here
# that protect anything real, and use different ones wherever the demo is hosted.
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_ADMIN_PASSWORD=DemoAdmin-2026!
NEXT_PUBLIC_DEMO_CUSTOMER_PASSWORD=DemoCustomer-2026!
