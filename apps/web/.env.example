# FixFlow web app — environment variables.
# Copy this file to `.env.local` for local development. Never commit `.env*` files other than
# this example, and never expose secrets through a NEXT_PUBLIC_ variable.

# Server-only (no NEXT_PUBLIC_ prefix). Where the Next.js server reaches the Express API.
# The browser never needs this: it calls /api/v1/* on the web origin and Next.js rewrites it here.
# next.config.ts reads it at BUILD time, so deployments must set it before `next build`.
# Defaults to http://localhost:4000 when unset.
API_INTERNAL_URL=http://localhost:4000
