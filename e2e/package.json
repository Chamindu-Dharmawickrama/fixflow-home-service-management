{
  "name": "@fixflow/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "FixFlow Playwright end-to-end tests",
  "type": "module",
  "scripts": {
    "install:browsers": "playwright install chromium",
    "test:e2e": "playwright test && playwright test -c playwright.showcase.config.ts",
    "test:e2e:showcase": "playwright test -c playwright.showcase.config.ts",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2"
  }
}
