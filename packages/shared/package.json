{
  "name": "@fixflow/shared",
  "version": "0.0.0",
  "private": true,
  "description": "Shared enums, constants, error codes and pure helpers used by the web app and the API (no I/O, no framework code)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "decimal.js": "^10.6.0"
  }
}
